summit.assets.html = "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <meta name=\"theme-color\" content=\"#101512\">\n    <meta name=\"description\" content=\"Summit is a focused SEO workspace. Understand your search performance, review improvements, and audit your page HTML.\">\n    <title>Summit — Your search, in focus.</title>\n    <link rel=\"icon\" href=\"data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48'%3E%3Crect width='48' height='48' rx='12' fill='%23101512'/%3E%3Cpath d='M8 35 23 10l17 25H29L23 24l-6 11Z' fill='%23b8eb9b'/%3E%3C/svg%3E\">\n    <link rel=\"stylesheet\" href=\"./styles.css\">\n    <script src=\"./app.js\" defer></script>\n  </head>\n  <body>\n    <a class=\"skip-link\" href=\"#main\">Skip to content</a>\n    <div id=\"app\"></div>\n    <div id=\"overlay-root\"></div>\n    <div id=\"toast\" role=\"status\" aria-live=\"polite\"></div>\n    <noscript>This workspace needs JavaScript enabled to display analytics and run audits.</noscript>\n  </body>\n</html>\n"

