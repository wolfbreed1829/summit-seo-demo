summit.assets.css = ":root{color-scheme:dark;--bg:#101512;--sidebar:#131815;--panel:#191f1b;--panel-hover:#202822;--line:#2a332c;--text:#f1f3ec;--muted:#a0ada2;--subtle:#8b9b8e;--mint:#b8eb9b;--mint-soft:#223321;--amber:#e6c47f;--danger:#e8a297;--radius:14px;--font:'DM Sans','Segoe UI',sans-serif}\n*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font-family:var(--font);font-size:15px;line-height:1.5;-webkit-font-smoothing:antialiased}button,input,select,textarea{font:inherit}button,a,input,select,textarea{-webkit-tap-highlight-color:transparent}button{cursor:pointer}button{color:inherit}button:disabled{cursor:wait;opacity:.55}button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:2px solid var(--mint);outline-offset:4px}button{border:0}a{color:var(--mint)}svg{display:block;flex-shrink:0}.icon{width:19px;height:19px;stroke:currentColor;stroke-width:1.6;fill:none;stroke-linecap:round;stroke-linejoin:round}h1,h2,h3,p{margin:0}h1{font-size:35px;font-weight:500;letter-spacing:-1.25px;line-height:1.25}h2{font-size:18px;line-height:1.35;font-weight:550;letter-spacing:-.3px}h3{font-size:17px;font-weight:550}p{color:var(--muted)}small{font-size:12px}strong{font-weight:600}button{transition:background .15s,color .15s,transform .15s}button:active{transform:translateY(1px)}.skip-link{position:fixed;z-index:100;top:-70px;left:20px;padding:12px 18px;background:var(--mint);color:var(--bg);border-radius:6px}.skip-link:focus{top:12px}.sidebar{position:fixed;inset:0 auto 0 0;z-index:30;width:230px;background:var(--sidebar);border-right:1px solid var(--line);display:flex;flex-direction:column;padding:34px 20px 20px}.brand{display:flex;align-items:center;gap:11px;padding-left:11px;text-decoration:none;color:var(--text);letter-spacing:3.8px;font-size:22px;font-weight:650}.brand-mark{width:34px;height:34px;color:var(--mint)}.workspace{margin-top:38px;margin-bottom:32px;padding:13px 11px;width:100%;text-ali